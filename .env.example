# testnet | mainnet
STRIKE_NETWORK=testnet

# Ed25519 API wallet (generate with `npm run keygen`; never commit .env)
STRIKE_API_PRIVATE_KEY=
STRIKE_API_PUBLIC_KEY=

# Optional: only if your API key is bound to the master account and you want the
# agent on a specific sub-account. Simplest is to create the key ON the sub-account.
STRIKE_SUB_ACCOUNT_ID=

# Builder code fee in bps (0–100). Leave 0 until the builder code is registered.
STRIKE_BUILDER_FEE_BPS=0

# Claude for trade explanations (Phase 2)
ANTHROPIC_API_KEY=
