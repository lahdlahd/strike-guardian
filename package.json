{
  "name": "strike-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "tsx agent/run.ts",
    "keygen": "tsx scripts/keygen.ts",
    "keygen:attest": "tsx scripts/keygen-attest.ts",
    "smoke": "tsx scripts/smoke.ts",
    "kill": "tsx scripts/kill.ts",
    "resume": "tsx scripts/kill.ts --resume",
    "verify": "tsx scripts/verify.ts",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "explain:test": "tsx scripts/explain-test.ts",
    "report": "tsx scripts/report.ts",
    "export": "tsx scripts/export.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "dotenv": "17.2.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
